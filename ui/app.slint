import { VerticalBox, HorizontalBox, TextEdit } from "std-widgets.slint";

component MenuButton inherits Rectangle {
    in property <string> label: "";
    in property <brush> menu_text_fg: #d7d4cf;
    in property <brush> menu_hover_text_fg: #a77be8;
    in property <brush> menu_bg: #14151c;
    in property <brush> menu_hover_bg: #181920;
    in property <brush> menu_border: #2f3140;
    in property <string> menu_font_family: "IM FELL English";
    callback activated();

    height: 28px;
    min-width: 72px;
    background: touch.has-hover ? root.menu_hover_bg : root.menu_bg;
    border-width: 1px;
    border-color: root.menu_border;

    Text {
        text: root.label;
        color: touch.has-hover ? root.menu_hover_text_fg : root.menu_text_fg;
        font-family: root.menu_font_family;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

component ToolbarButton inherits Rectangle {
    in property <string> label: "";
    in property <length> button_min_width: 150px;
    in property <brush> button_bg: #2b2933;
    in property <brush> button_hover_bg: #18171d;
    in property <brush> button_border: #3a3744;
    in property <brush> button_text_fg: #d7d4cf;
    in property <brush> button_hover_text_fg: #a9aae2;
    in property <string> button_font_family: "IM FELL English";
    callback activated();

    height: 34px;
    min-width: root.button_min_width;
    background: touch.has-hover ? root.button_hover_bg : root.button_bg;
    border-width: 1px;
    border-color: root.button_border;

    Text {
        text: root.label;
        color: touch.has-hover ? root.button_hover_text_fg : root.button_text_fg;
        font-family: root.button_font_family;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

component HeaderBlock inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> ui_font_family: "IM FELL English";
    in property <brush> heading_fg: #a9aae2;
    in property <brush> body_fg: #bc8d6b;
    in property <length> title_font_size: 30px;
    in property <length> subtitle_font_size: 15px;
    in property <length> header_spacing: 4px;

    height: 64px;
    VerticalBox {
        height: parent.height;
        spacing: root.header_spacing;

        Text {
            text: root.title;
            font-family: root.ui_font_family;
            font-size: root.title_font_size;
            font-weight: 700;
            color: root.heading_fg;
        }

        Text {
            text: root.subtitle;
            font-family: root.ui_font_family;
            font-size: root.subtitle_font_size;
            color: root.body_fg;
            wrap: word-wrap;
        }
    }
}

component EditorPane inherits Rectangle {
    in property <string> heading: "";
    in property <string> hint: "";
    in-out property <string> editor_text: "";

    in property <brush> app_bg: #222129;
    in property <brush> panel_bg: #18171d;
    in property <brush> theme_border: #3a3744;
    in property <brush> heading_fg: #a9aae2;
    in property <brush> muted_fg: #8f879f;

    in property <string> ui_font_family: "IM FELL English";
    in property <string> editor_font_family: "monospace";

    in property <length> heading_font_size: 18px;
    in property <length> hint_font_size: 13px;
    in property <length> editor_font_size: 14px;
    in property <length> heading_row_height: 30px;
    in property <length> panel_spacing: 8px;
    in property <length> editor_inner_padding: 10px;
    in property <length> editor_panel_min_width: 360px;

    min-width: root.editor_panel_min_width;
    vertical-stretch: 1;
    horizontal-stretch: 1;
    background: root.app_bg;

    VerticalBox {
        height: parent.height;
        spacing: root.panel_spacing;

        HorizontalBox {
            height: root.heading_row_height;
            spacing: 8px;

            Text {
                text: root.heading;
                font-family: root.ui_font_family;
                font-size: root.heading_font_size;
                font-weight: 700;
                color: root.heading_fg;
                vertical-alignment: center;
            }

            Text {
                text: root.hint;
                horizontal-stretch: 1;
                font-family: root.ui_font_family;
                font-size: root.hint_font_size;
                color: root.muted_fg;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.panel_bg;
            border-width: 1px;
            border-color: root.theme_border;

            TextEdit {
                text <=> root.editor_text;
                width: parent.width - (root.editor_inner_padding * 2);
                height: parent.height - (root.editor_inner_padding * 2);
                x: root.editor_inner_padding;
                y: root.editor_inner_padding;
                font-family: root.editor_font_family;
                font-size: root.editor_font_size;
            }
        }
    }
}

component StatusFooter inherits Rectangle {
    in property <string> footer_text: "";
    in property <string> ui_font_family: "IM FELL English";
    in property <brush> panel_bg: #18171d;
    in property <brush> theme_border: #3a3744;
    in property <brush> muted_fg: #8f879f;
    in property <length> footer_font_size: 13px;

    height: 34px;
    background: root.panel_bg;
    border-width: 1px;
    border-color: root.theme_border;

    Text {
        x: 12px;
        y: 7px;
        text: root.footer_text;
        font-family: root.ui_font_family;
        color: root.muted_fg;
        font-size: root.footer_font_size;
    }
}

export component AppWindow inherits Window {
    title: root.window_title;
    preferred-width: root.window_width;
    preferred-height: root.window_height;
    min-width: root.window_min_width;
    min-height: root.window_min_height;
    background: root.app_bg;

    // ------------------------------------------------------------
    // Content state
    // ------------------------------------------------------------

    in-out property <string> input_text: "";
    in-out property <string> output_text: "";
    in-out property <string> status_text: "Paste messy LLM, GitHub, browser, or wiki Markdown on the left, then clean it.";

    // ------------------------------------------------------------
    // Window text
    // ------------------------------------------------------------

    in-out property <string> window_title: "LLM MD Cleaner";
    in-out property <string> app_title: "LLM MD Cleaner";
    in-out property <string> app_subtitle: "A native Markdown cleanup utility for copied LLM output, broken code fences, flattened tables, and other linsey-woolsey nonsense.";
    in-out property <string> input_heading: "Messy Input";
    in-out property <string> input_hint: "Paste from ChatGPT, GitHub, browser copy, or wiki preview.";
    in-out property <string> output_heading: "Clean Markdown";
    in-out property <string> output_hint: "Copy this wherever your Markdown needs to go.";
    in-out property <string> footer_text: "LLM output in → cleaned Markdown out.";

    // ------------------------------------------------------------
    // Button labels
    // ------------------------------------------------------------

    in-out property <string> clean_button_text: "Clean Markdown";
    in-out property <string> copy_button_text: "Copy Output";
    in-out property <string> clear_button_text: "Clear";

    // ------------------------------------------------------------
    // Theme colors
    // ------------------------------------------------------------

    in-out property <brush> app_bg: #222129;
    in-out property <brush> toolbar_bg: #2b2933;
    in-out property <brush> panel_bg: #18171d;
    in-out property <brush> theme_border: #3a3744;
    in-out property <brush> theme_divider: #4a4558;
    in-out property <brush> heading_fg: #a9aae2;
    in-out property <brush> body_fg: #bc8d6b;
    in-out property <brush> muted_fg: #8f879f;

    // ------------------------------------------------------------
    // Fonts
    // ------------------------------------------------------------

    in-out property <string> ui_font_family: "IM FELL English";
    in-out property <string> editor_font_family: "monospace";

    in-out property <length> title_font_size: 30px;
    in-out property <length> subtitle_font_size: 15px;
    in-out property <length> heading_font_size: 18px;
    in-out property <length> hint_font_size: 13px;
    in-out property <length> status_font_size: 14px;
    in-out property <length> editor_font_size: 14px;
    in-out property <length> footer_font_size: 13px;

    // ------------------------------------------------------------
    // Layout sizing
    // ------------------------------------------------------------

    in-out property <length> window_width: 1180px;
    in-out property <length> window_height: 820px;
    in-out property <length> window_min_width: 920px;
    in-out property <length> window_min_height: 640px;

    in-out property <length> root_padding: 24px;
    in-out property <length> root_spacing: 16px;

    in-out property <length> menu_bar_height: 40px;
    in-out property <length> menu_bar_padding_horizontal: 8px;
    in-out property <length> menu_bar_spacing: 8px;

    in-out property <length> header_spacing: 4px;
    in-out property <length> toolbar_height: 52px;
    in-out property <length> toolbar_padding_horizontal: 12px;
    in-out property <length> toolbar_padding_vertical: 8px;
    in-out property <length> toolbar_spacing: 10px;

    in-out property <length> editor_panel_min_width: 360px;
    in-out property <length> editor_inner_padding: 10px;
    in-out property <length> panel_spacing: 8px;
    in-out property <length> split_spacing: 14px;
    in-out property <length> heading_row_height: 30px;

    // ------------------------------------------------------------
    // Callbacks
    // ------------------------------------------------------------

    callback clean_requested();
    callback copy_requested();

    // Theme and Font Callbacks
    callback theme_system_requested();
    callback theme_moribund_requested();
    callback theme_dark_requested();
    callback theme_light_requested();
    callback editor_font_default_requested();
    callback editor_font_monospace_requested();
    callback editor_font_larger_requested();
    callback editor_font_smaller_requested();
    callback editor_font_upload_requested();
    callback editor_font_family_changed(string);

    VerticalBox {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // Custom Moribund menu row.
        Rectangle {
            height: root.menu_bar_height;
            background: root.toolbar_bg;
            border-width: 1px;
            border-color: root.theme_border;

            HorizontalBox {
                padding-left: root.menu_bar_padding_horizontal;
                padding-right: root.menu_bar_padding_horizontal;
                spacing: root.menu_bar_spacing;
                alignment: start;

                Text {
                    text: "Theme";
                    color: root.muted_fg;
                    font-family: root.ui_font_family;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                MenuButton {
                    label: "System";
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.theme_system_requested(); }
                }

                MenuButton {
                    label: "Moribund";
                    min-width: 86px;
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.theme_moribund_requested(); }
                }

                MenuButton {
                    label: "Dark";
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.theme_dark_requested(); }
                }

                MenuButton {
                    label: "Light";
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.theme_light_requested(); }
                }

                Rectangle {
                    width: 1px;
                    background: root.theme_divider;
                }

                Text {
                    text: "Editor Font";
                    color: root.muted_fg;
                    font-family: root.ui_font_family;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                MenuButton {
                    label: "Default";
                    min-width: 76px;
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.editor_font_default_requested(); }
                }

                MenuButton {
                    label: "Monospace";
                    min-width: 90px;
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.editor_font_monospace_requested(); }
                }

                MenuButton {
                    label: "+";
                    min-width: 34px;
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.editor_font_larger_requested(); }
                }

                MenuButton {
                    label: "-";
                    min-width: 34px;
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.editor_font_smaller_requested(); }
                }

                MenuButton {
                    label: "Upload...";
                    min-width: 86px;
                    menu_font_family: root.ui_font_family;
                    menu_text_fg: root.body_fg;
                    menu_hover_text_fg: root.heading_fg;
                    menu_bg: root.toolbar_bg;
                    menu_hover_bg: root.panel_bg;
                    menu_border: root.theme_border;
                    activated => { root.editor_font_upload_requested(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.app_bg;

            VerticalBox {
                x: root.root_padding;
                y: root.root_padding;
                width: parent.width - (root.root_padding * 2);
                height: parent.height - (root.root_padding * 2);
                spacing: root.root_spacing;

                HeaderBlock {
                    title: root.app_title;
                    subtitle: root.app_subtitle;
                    ui_font_family: root.ui_font_family;
                    heading_fg: root.heading_fg;
                    body_fg: root.body_fg;
                    title_font_size: root.title_font_size;
                    subtitle_font_size: root.subtitle_font_size;
                    header_spacing: root.header_spacing;
                }

                Rectangle {
                    height: root.toolbar_height;
                    background: root.toolbar_bg;
                    border-width: 1px;
                    border-color: root.theme_border;

                    HorizontalBox {
                        padding-left: root.toolbar_padding_horizontal;
                        padding-right: root.toolbar_padding_horizontal;
                        padding-top: root.toolbar_padding_vertical;
                        padding-bottom: root.toolbar_padding_vertical;
                        spacing: root.toolbar_spacing;

                        ToolbarButton {
                            button_min_width: 190px;
                            label: root.clean_button_text;
                            button_font_family: root.ui_font_family;
                            button_bg: root.toolbar_bg;
                            button_hover_bg: root.panel_bg;
                            button_border: root.theme_border;
                            button_text_fg: root.body_fg;
                            button_hover_text_fg: root.heading_fg;
                            activated => { root.clean_requested(); }
                        }

                        ToolbarButton {
                            button_min_width: 190px;
                            label: root.copy_button_text;
                            button_font_family: root.ui_font_family;
                            button_bg: root.toolbar_bg;
                            button_hover_bg: root.panel_bg;
                            button_border: root.theme_border;
                            button_text_fg: root.body_fg;
                            button_hover_text_fg: root.heading_fg;
                            activated => { root.copy_requested(); }
                        }

                        ToolbarButton {
                            button_min_width: 150px;
                            label: root.clear_button_text;
                            button_font_family: root.ui_font_family;
                            button_bg: root.toolbar_bg;
                            button_hover_bg: root.panel_bg;
                            button_border: root.theme_border;
                            button_text_fg: root.body_fg;
                            button_hover_text_fg: root.heading_fg;
                            activated => {
                                root.input_text = "";
                                root.output_text = "";
                                root.status_text = "Cleared. Ready for fresh ritual debris.";
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: root.theme_divider;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.status_text;
                            font-family: root.ui_font_family;
                            color: root.body_fg;
                            font-size: root.status_font_size;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalBox {
                    vertical-stretch: 1;
                    spacing: root.split_spacing;

                    EditorPane {
                        heading: root.input_heading;
                        hint: root.input_hint;
                        editor_text <=> root.input_text;
                        app_bg: root.app_bg;
                        panel_bg: root.panel_bg;
                        theme_border: root.theme_border;
                        heading_fg: root.heading_fg;
                        muted_fg: root.muted_fg;
                        ui_font_family: root.ui_font_family;
                        editor_font_family: root.editor_font_family;
                        heading_font_size: root.heading_font_size;
                        hint_font_size: root.hint_font_size;
                        editor_font_size: root.editor_font_size;
                        heading_row_height: root.heading_row_height;
                        panel_spacing: root.panel_spacing;
                        editor_inner_padding: root.editor_inner_padding;
                        editor_panel_min_width: root.editor_panel_min_width;
                    }

                    EditorPane {
                        heading: root.output_heading;
                        hint: root.output_hint;
                        editor_text <=> root.output_text;
                        app_bg: root.app_bg;
                        panel_bg: root.panel_bg;
                        theme_border: root.theme_border;
                        heading_fg: root.heading_fg;
                        muted_fg: root.muted_fg;
                        ui_font_family: root.ui_font_family;
                        editor_font_family: root.editor_font_family;
                        heading_font_size: root.heading_font_size;
                        hint_font_size: root.hint_font_size;
                        editor_font_size: root.editor_font_size;
                        heading_row_height: root.heading_row_height;
                        panel_spacing: root.panel_spacing;
                        editor_inner_padding: root.editor_inner_padding;
                        editor_panel_min_width: root.editor_panel_min_width;
                    }
                }

                StatusFooter {
                    footer_text: root.footer_text;
                    ui_font_family: root.ui_font_family;
                    panel_bg: root.panel_bg;
                    theme_border: root.theme_border;
                    muted_fg: root.muted_fg;
                    footer_font_size: root.footer_font_size;
                }
            }
        }
    }
}
